{
  "$schema":"http://json-schema.org/draft-07/schema#",
  "$id":"https://haili.app/schemas/jmap-push-v1.json",
  "title":"Hail JMAP push objects",
  "definitions":{
    "id":{"type":"string","pattern":"^[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$"},
    "code":{"type":"string","pattern":"^[A-Za-z0-9_-]{43}$"},
    "types":{"type":"array","uniqueItems":true,"maxItems":6,"items":{"enum":["HailMessage","HailDraft","HailSent","HailSubmission","HailGrant","HailRelationship"]}},
    "expires":{"type":"string","format":"date-time","pattern":"Z$"},
    "verification":{"type":"object","additionalProperties":false,"required":["@type","pushSubscriptionId","verificationCode"],"properties":{"@type":{"const":"PushVerification"},"pushSubscriptionId":{"$ref":"#/definitions/id"},"verificationCode":{"$ref":"#/definitions/code"}}},
    "subscription":{"type":"object","additionalProperties":false,"required":["id","deviceClientId","verificationCode","expires","types"],"properties":{"id":{"$ref":"#/definitions/id"},"deviceClientId":{"type":"string","minLength":1,"maxLength":255},"verificationCode":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/code"}]},"verificationError":{"enum":[null,"pushServiceRejected","deliveryFailed"]},"expires":{"$ref":"#/definitions/expires"},"types":{"$ref":"#/definitions/types"}}},
    "create":{"type":"object","additionalProperties":false,"required":["deviceClientId","url","keys"],"properties":{"deviceClientId":{"type":"string","minLength":1,"maxLength":255},"url":{"type":"string","format":"uri","maxLength":2048,"pattern":"^https://"},"keys":{"type":"object","additionalProperties":false,"required":["p256dh","auth"],"properties":{"p256dh":{"type":"string","pattern":"^[A-Za-z0-9_-]{87}$"},"auth":{"type":"string","pattern":"^[A-Za-z0-9_-]{22}$"}}},"types":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/types"}]},"expires":{"anyOf":[{"type":"null"},{"$ref":"#/definitions/expires"}]},"verificationCode":{"type":"null"}}}
  },
  "anyOf":[{"$ref":"#/definitions/verification"},{"$ref":"#/definitions/subscription"},{"$ref":"#/definitions/create"}]
}
