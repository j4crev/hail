{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hail monitor provider origin-verification document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "version", "monitorApiOrigin", "providerOrigin", "alertOrigin", "registrationHash", "expiresAt"],
  "properties": {
    "type": { "const": "hail.monitor-provider-registration" },
    "version": { "const": 1 },
    "monitorApiOrigin": { "type": "string", "format": "uri", "pattern": "^https://[^/:?#@]+$" },
    "providerOrigin": { "type": "string", "format": "uri", "pattern": "^https://[^/:?#@]+$" },
    "alertOrigin": { "type": "string", "format": "uri", "pattern": "^https://[^/:?#@]+$" },
    "registrationHash": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "expiresAt": { "type": "integer", "minimum": 1 }
  },
  "$comment": "Also enforce canonical HTTPS DNS origins, public address validation, exact expected document values and a future expiry at most one hour ahead; see monitor-providers.md."
}
