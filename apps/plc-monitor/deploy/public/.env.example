MONITOR_DB_PASSWORD=replace-with-a-random-base64url-secret
MONITOR_ORIGIN=https://monitor.example.com
# Optional multi-provider enrollment API; empty HOST/PORT keeps it disabled.
MONITOR_API_HOST=
MONITOR_API_PORT=
# Public enrollment/registration HTTPS origin; defaults to MONITOR_ORIGIN.
MONITOR_API_ORIGIN=
# Shared receiver for every registered provider (spec/monitor-receiver.md).
# Provider registration returns 503 until this is set.
MONITOR_RECEIVER_ORIGIN=
# Enable only behind an isolated proxy that overwrites X-Hail-Monitor-Client-IP.
MONITOR_TRUST_PROXY=false
