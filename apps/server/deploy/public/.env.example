# Fresh deployments: set to the image@sha256 reference from verified CI.
# Existing managed hosts use /etc/hail-provider-release/compose.json instead.
HAIL_WEB_CLIENT_IMAGE=
HAIL_PROVIDER_IMAGE=
PROVIDER_DOMAIN=svr.haili.app
WEB_CLIENT_DOMAIN=haili.app
NATIVE_ADDRESS_DOMAIN=haili.app
PROVIDER_ID=haili
PLC_PROVIDER_OPERATORS=["haili-provider"]
PLC_READER_DIAGNOSTIC_DID=
DB_PASSWORD=replace-with-generated-base64url-value
KEY_ENCRYPTION_KEY=replace-with-43-character-base64url-value
PUBLIC_SELF_SERVICE_ONBOARDING=false
PASSKEY_AUTH=true
# Optional signup email proxy; configure both to enable. Keep token server-only.
SIGNUP_EMAIL_ORIGIN=
SIGNUP_EMAIL_TOKEN=
# Optional automatic alpha monitoring; requires email plus strict public PLC.
SIGNUP_MONITOR_API_ORIGIN=
SIGNUP_MONITOR_TOKEN=
SIGNUP_MONITOR_PUBLIC_KEY=
# Local backend is implemented; leave off until reviewed invited-pilot rollout.
PUBLIC_ALPHA_SIGNUP=false
ALPHA_SIGNUP_INVITE_KEY=
ALPHA_SIGNUP_MONITOR_ORIGIN=

# Browser session lifetimes: 7 days idle, 30 days absolute (in seconds).
PASSKEY_SESSION_IDLE_SECONDS=604800
PASSKEY_SESSION_ABSOLUTE_SECONDS=2592000

# Optional encrypted browser notifications; configure all three together.
# Keep the private key secret and stable across provider restarts.
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=

# Optional inbound email bridge (spec/email-bridge.md). Set all three together,
# or leave all empty to keep it off; the provider refuses partial settings. The
# intake token is an independent secret shared only with the ingress Worker.
EMAIL_BRIDGE_DOMAIN=
EMAIL_BRIDGE_INTAKE_TOKEN=
EMAIL_BRIDGE_SENDER=
# The converter's database password (32 random bytes, unpadded base64url). Setting
# it makes hail-provider-ops run the converter; create its role with
# `hail-provider-ops email-converter-role` after the release is deployed.
EMAIL_CONVERTER_DB_PASSWORD=
