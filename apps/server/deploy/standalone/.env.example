# Immutable image references from a verified publication. Client is optional.
HAIL_PROVIDER_IMAGE=
HAIL_WEB_CLIENT_IMAGE=
PROVIDER_DOMAIN=svr.example.com
# Required when adding the optional GUI; must differ from PROVIDER_DOMAIN.
WEB_CLIENT_DOMAIN=example.com
# Native account addresses use this domain, not the API hostname.
NATIVE_ADDRESS_DOMAIN=example.com
PROVIDER_ID=example
PLC_PROVIDER_OPERATORS=["example-operator"]
DB_PASSWORD=replace-with-independent-base64url-secret
KEY_ENCRYPTION_KEY=replace-with-independent-32-byte-base64url-secret
PUBLIC_SELF_SERVICE_ONBOARDING=false
PUBLIC_ALPHA_SIGNUP=false
SIGNUP_EMAIL_ORIGIN=
SIGNUP_EMAIL_TOKEN=
SIGNUP_MONITOR_API_ORIGIN=
SIGNUP_MONITOR_TOKEN=
SIGNUP_MONITOR_PUBLIC_KEY=
ALPHA_SIGNUP_INVITE_KEY=
ALPHA_SIGNUP_MONITOR_ORIGIN=
HAIL_WEB_CLIENT_NAME=Hail
HAIL_WEB_CLIENT_LOGO_PATH=
HAIL_WEB_CLIENT_FAVICON_PATH=/favicon.svg

# Optional encrypted browser notifications; configure all three together.
# Keep the private key secret and stable across provider restarts.
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
