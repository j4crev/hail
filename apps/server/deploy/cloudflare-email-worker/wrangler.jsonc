{
  // Cloudflare ingress adapter for the email bridge. See README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hail-email-bridge",
  "main": "worker.ts",
  "compatibility_date": "2026-10-20",
  // Mail reaches this Worker only through Email Routing; it serves no web requests.
  "workers_dev": false,
  "preview_urls": false,
  // Keeps invocation logs, including why a hand-off to the provider failed.
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "PENDING", "bucket_name": "hail-email-bridge-pending" }
  ],
  "queues": {
    "producers": [
      { "binding": "RETRY", "queue": "hail-email-bridge-retry" }
    ],
    "consumers": [
      // The Worker decides when to give up (MAX_ATTEMPTS); this only bounds a crashing consumer.
      { "queue": "hail-email-bridge-retry", "max_batch_size": 5, "max_retries": 100 }
    ]
  },
  "vars": {
    "PROVIDER_ORIGIN": "https://svr.haili.app",
    "ALIAS_DOMAIN": "haili.email"
  }
}
