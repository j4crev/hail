# Required public HTTPS provider origin; no default hosted provider.
HAIL_WEB_CLIENT_PROVIDER=https://provider.example.com
# Optional separate backend transport; defaults to the provider origin.
# Compose uses the explicitly supported private http://provider:3000 transport.
HAIL_WEB_CLIENT_API_ORIGIN=
# Browser origin must agree with provider passkey and Origin configuration.
HAIL_WEB_CLIENT_ORIGIN=https://app.example.com
ORIGIN=https://app.example.com
# Native signup address domain; defaults to the provider hostname.
HAIL_NATIVE_ADDRESS_DOMAIN=example.com
HAIL_WEB_CLIENT_NAME=Hail
HAIL_WEB_CLIENT_LOGO_PATH=
HAIL_WEB_CLIENT_FAVICON_PATH=/favicon.svg
HAIL_WEB_CLIENT_SIGNUP=false
